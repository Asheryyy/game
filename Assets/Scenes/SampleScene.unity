  dialogueLines: []
  requiredQuestId: find_phone
  dialogueBefore:
  - speakerName: Coca
    text: "M\xE0y c\xF3 ph\u1EA3i l\xE0 b\u1EA1n c\u1EE7a V\u0169 kh\xF4ng?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "C\u01A1"
    text: "\u1EEA tao \u0111\xE2y , m\xE0y t\xECm tao c\xF3 chuy\u1EC7n g\xEC?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: Coca
    text: "Tao nh\u1EADn \u0111\u01B0\u1EE3c l\u1EC7nh t\u1EEB anh \u1ED8 b\u1EA3o
      l\xE0 ph\u1EA3i t\xECm s\u1ED1 \u0111i\u1EC7n tho\u1EA1i c\u1EE7a V\u0169,
      n\xEAn tao c\u1EA7n m\xE0y gi\xFAp tao."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "C\u01A1"
    text: "Th\xF4i \u0111\u01B0\u1EE3c , tao s\u1EBD cho m\xE0y s\u1ED1 \u0111i\u1EC7n
      tho\u1EA1i c\u1EE7a n\xF3 v\u1EDBi \u0111i\u1EC1u ki\u1EC7n m\xE0y ph\u1EA3i
      gi\xFAp tao g\u1EB7p anh \u1ED8, tao l\xE0 fan c\u1EE7a anh \u1EA5y."
    questToGive:
      questId: gap_Do
      questName: FanMeeting
      description: "H\xE3y cho C\u01A1 , fan c\u1EE7a anh \u1ED8 g\u1EB7p anh \u1EA5y"
      isCompleted: 0
      isActive: 1
      isGoalReached: 0

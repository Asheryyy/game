  npc: {fileID: 151366774}
  deliverLines:
  - speakerName: "Anh trai h\u1ECD Ph\xF9ng"
    text: "Em m\u1EDBi t\u1EDBi \u0111\xE2y l\xE0m \xE0, anh th\u1EA5y ch\xFA em

  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryDoor
  day: {fileID: 1939080295}
  orderIndex: 0
  hintText: "B\u1EA5m [E] \u0111\u1EC3 giao h\xE0ng"
  emptyHandText: "Ch\u01B0a c\xF3 h\xE0ng c\u1EE7a nh\xE0 n\xE0y \u2014 ra kho l\u1EA5y"
  wrongBoxText: "Kh\xF4ng ph\u1EA3i h\xE0ng c\u1EE7a nh\xE0 n\xE0y"
  npc: {fileID: 339587885}
  deliverLines:
  - speakerName: "T\xF4i"
    text: "Hello ch\u1ECB g\xE1i, em giao th\u1ECBt cho ch\u1ECB \u0111\xE2y, nay
      \u0111\xF4ng kh\xE1ch th\u1EBF nh\u1EDF."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "Ch\u1ECB b\xE1n pho"
    text: "Nay ng\u01B0\u1EDDi m\u1EDBi giao \xE0, ch\u1ECB c\u1EA3m \u01A1n nh\xE9."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Cho em h\u1ECFi t\xED, ch\u1ECB \u1EDF khu n\xE0y ch\u1EAFc ch\u1ECB bi\u1EBFt
      nhi\u1EC1u chuy\u1EC7n \u1EDF khu chung c\u01B0 n\xE0y \u0111\xFAng kh\xF4ng?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Cho em h\u1ECFi t\xED, ch\u1ECB \u1EDF khu n\xE0y ch\u1EAFc ch\u1ECB bi\u1EBFt
      nhi\u1EC1u chuy\u1EC7n \u1EDF khu chung c\u01B0 n\xE0y \u0111\xFAng kh\xF4ng?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "Ch\u1ECB b\xE1n pho"
    text: "Ch\u1ECB th\u1EA5y nhi\u1EC1u th\u1EE9 l\u1EAFm, x\u01B0a ch\u1ECB c\xF2n
      th\u1EA5y c\u1EA3nh t\u1EE5i n\xF3 \u0111\xE2m nhau qua c\u1EEDa s\u1ED5 m\xE0.
      C\xF2n nhi\u1EC1u chuy\u1EC7n l\u1EAFm m\xE0 k\u1EC3 v\u1EDBi em ch\u1EAFc
      h\u1EBFt c\u1EA3 ng\xE0y qu\xE1, th\xF4i \u0111i l\xE0m \u0111i em"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Nghe c\u0103ng th\u1EBF nh\u1EDF, th\xF4i \u0111\u1EC3 b\u1EEFa n\xE0o
      r\u1EA3nh ch\u1ECB em m\xECnh t\xE2m s\u1EF1 ri\xEAng sau."
    questToGive:
      questId: 

  m_Script: {fileID: 11500000, guid: 0ed1edb9553328446be2c3a660451245, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Trigger
  questToGive:
    questId: 
    questName: 
    description: 
    isCompleted: 0
    isActive: 0
    isGoalReached: 0
  dialogueLines: []
  requiredQuestId: 
  dialogueBefore:
  - speakerName: "Giang H\u1ED3"
    text: "\xCA ku, m\xE0y l\xE0 ng\u01B0\u1EDDi m\u1EDBi \u0111\u1EBFn \xE0. Tao
      th\u1EA5y d\u1EA1o n\xE0y vi\u1EC7c giao h\xE0ng c\u1EE7a m\xE0y c\u0169ng
      r\u1EA3nh r\u1ED7i qu\xE1 nh\u1EC9?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "Giang H\u1ED3"
    text: "R\u1EA3nh t\u1EDBi n\u1ED5i tao th\u1EA5y m\xE0y b\u1EAFt \u0111\u1EA7u
      lo nh\u1EEFng chuy\u1EC7n linh tinh r\u1ED3i \u0111\u1EA5y."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "Giang H\u1ED3"
    text: "Tao cho m\xE0y 2 l\u1EF1a ch\u1ECDn, m\u1ED9t l\xE0 m\xE0y t\u1EF1 c\xE2m
      c\xE1i mi\u1EC7ng l\u1EA1i, c\xF2n hai l\xE0 tao s\u1EBD gi\xFAp m\xE0y."
    questToGive:
      questId: chay_ve_nha
      questName: "Ch\u1EA1y v\u1EC1 nh\xE0!"
      description: "C\u1EAFt \u0111u\xF4i b\u1ECDn giang h\u1ED3, t\xECm \u0111\u01B0\u1EDDng
        kh\xE1c v\u1EC1 chung c\u01B0"
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  dialogueDuring: []
  dialogueAfter: []
  playOnce: 1
  questToCompleteOnTalk: ve_chung_cu_ngay3
  activateAfterTalk: []

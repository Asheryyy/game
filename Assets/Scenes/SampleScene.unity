  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5775b86eb5e3ccb408e152ca2f82af6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryDoor
  day: {fileID: 1939080295}
  orderIndex: 1
  hintText: "B\u1EA5m [E] \u0111\u1EC3 giao h\xE0ng"
  emptyHandText: "Ch\u01B0a c\xF3 h\xE0ng c\u1EE7a nh\xE0 n\xE0y \u2014 ra kho l\u1EA5y"
  wrongBoxText: "Kh\xF4ng ph\u1EA3i h\xE0ng c\u1EE7a nh\xE0 n\xE0y"
  npc: {fileID: 248888749}
  deliverLines:
  - speakerName: "T\xF4i"
    text: "Ch\xFA giao h\xE0ng \u0111\xE2y, m\u1EB9 con \u0111\xE2u."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "C\u1EADu b\xE9"
    text: "Ch\xFA l\xE0 ng\u01B0\u1EDDi m\u1EDBi n\xEAn kh\xF4ng bi\u1EBFt \xE0?
      B\xECnh th\u01B0\u1EDDng m\u1EA5y ng\u01B0\u1EDDi giao h\xE0ng c\u0169 to\xE0n
      \u0111\u1EC3 s\u1EB5n \u1EDF b\xEAn chung c\u01B0 \u0111\u1EC3 cho m\u1EB9
      con l\u1EA5y th\xF4i"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Th\u1EBF \xE0, l\u1EE1 r\u1ED3i th\xF4i ch\xFA \u0111\u1EC3 t\u1EA1m \u0111\xE2y
      nh\xE9. M\xE0 sao m\u1EB9 con kh\xF4ng \u0111\u1EE3i ng\u01B0\u1EDDi ta giao
      m\xE0 ph\u1EA3i c\u1EA5t c\xF4ng \u0111i t\u1EDBi b\xEAn \u0111\xF3 v\u1EADy?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "C\u1EADu b\xE9"
    text: "Con c\u0169ng kh\xF4ng bi\u1EBFt, nh\u01B0ng t\u1EEB n\u0103m ngo\xE1i
      con th\u1EA5y m\u1EB9 con h\u01A1i l\u1EA1 nh\u01B0ng con h\u1ECFi th\xEC m\u1EB9
      con n\xF3i l\xE0 s\u1EB5n ti\u1EC7n l\u1EA5y lu\xF4n cho shipper \u0111\u1EE1
      c\u1EF1c."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "\xC0 ch\xFA hi\u1EC3u r\u1ED3i, v\u1EADy ch\xFA \u0111\u1EC3 \u0111\xE2y
      n\xE0o m\u1EB9 v\u1EC1 nh\u1EDB b\xE1o cho m\u1EB9 nh\xE9."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0

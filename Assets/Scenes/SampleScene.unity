  m_Script: {fileID: 11500000, guid: 5775b86eb5e3ccb408e152ca2f82af6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryDoor
  day: {fileID: 1939080295}
  orderIndex: 2
  hintText: "B\u1EA5m [E] \u0111\u1EC3 giao h\xE0ng"
  emptyHandText: "Ch\u01B0a c\xF3 h\xE0ng c\u1EE7a nh\xE0 n\xE0y \u2014 ra kho l\u1EA5y"
  wrongBoxText: "Kh\xF4ng ph\u1EA3i h\xE0ng c\u1EE7a nh\xE0 n\xE0y"
  npc: {fileID: 2126030647}
  deliverLines:
  - speakerName: "T\xF4i"
    text: "M\u1EDBi s\xE1ng s\u1EDBm m\xE0 t\u1EADp v\xF5 c\u0103ng d\u1EEF anh trai,
      \u0111\u1ECBnh \u0111i \u0111\xE1nh nhau \xE0?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "B\u1EA3o v\u1EC7"
    text: "L\xE0m b\u1EA3o v\u1EC7 kh\xF4ng t\u1EADp v\xF5 t\u1EE5i \xE1c v\xF4 n\xF3
      tr\u1ED9m m\xE0y \u0111\xE1nh t\u1EE5i n\xF3 nha?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Em gi\u1EE1n m\xE0, anh trai c\u0103ng th\u1EBF. em giao h\xE0ng cho anh
      n\xE0y."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Em gi\u1EE1n m\xE0, anh trai c\u0103ng th\u1EBF. em giao h\xE0ng cho anh
      n\xE0y."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "\xC0 m\xE0 s\u1EB5n cho em h\u1ECFi, ph\xF2ng 302 k\u1EBF b\xEAn em l\xE0m
      g\xEC m\xE0 \u1ED3n th\u1EBF, \u0111\xEAm qua em n\u1EB1m ng\u1EE7 m\xE0 c\u1EE9
      gi\u1EADt m\xECnh li\xEAn t\u1EE5c"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "B\u1EA3o v\u1EC7"
    text: "Ch\u1EAFc l\xE0 chu\u1ED9t g\xEC \u0111\xF3 th\xF4i, anh c\u0169ng kh\xF4ng
      bi\u1EBFt n\u1EEFa. Ng\u01B0\u1EDDi d\xE2n li\xEAn t\u1EE5c b\xE1o v\u1EC1
      m\xE0 l\xFAc anh l\xEAn ki\u1EC3m tra th\xEC c\xF3 th\u1EA5y g\xEC \u0111\xE2u,
      c\u0103n ph\xF2ng \u0111\xF3 \u0111\xE2u c\xF3 ng\u01B0\u1EDDi \u1EDF."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0

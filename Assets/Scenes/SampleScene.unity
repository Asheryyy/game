    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Em m\u1EDBi t\u1EDBi h\xF4m qua anh \u1EA1, em c\u0169ng \u1EDF t\u1EA7ng
      n\xE0y, c\u0103n ph\xF2ng cu\u1ED1i h\xE0nh lang l\xE0 em m\u1EDBi thu\xEA
      \u0111\u1EA5y anh.."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "Anh trai h\u1ECD Ph\xF9ng"
    text: "\u1ED2 ph\xF2ng cu\u1ED1i h\xE0nh lang \xE0, ch\xFA em gu c\u0169ng \u0111\u01B0\u1EE3c
      ph\xE9t \u0111\u1EA5y ch\u1EE9. C\xE1ch ph\xF2ng ch\xFA em 2 ph\xF2ng c\xF3
      con b\xE9 kia xinh l\u1EAFm,c\xF3 g\xEC em b\u1EAFt chuy\u1EC7n th\u1EED xem
      sao."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Haha th\u1EBF \xE0, th\u1EBF \u0111\u1EC3 h\xF4m n\xE0o em ki\u1EBFm c\u1EDB
      n\xF3i chuy\u1EC7n xem sao."

--- !u!114 &1793225617
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1793225615}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5775b86eb5e3ccb408e152ca2f82af6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryDoor
  day: {fileID: 923571958}
  orderIndex: 2
  hintText: "B\u1EA5m [E] \u0111\u1EC3 giao h\xE0ng"
  emptyHandText: "Ch\u01B0a c\xF3 h\xE0ng c\u1EE7a nh\xE0 n\xE0y \u2014 ra kho l\u1EA5y"
  wrongBoxText: "Kh\xF4ng ph\u1EA3i h\xE0ng c\u1EE7a nh\xE0 n\xE0y"
  npc: {fileID: 2044802223}
  deliverLines:
  - speakerName: "Em g\xE1i ph\xF2ng b\xEAn"
    text: "Em c\u1EA3m \u01A1n anh nh\xE9, em \u0111\xF3i s\u1EAFp x\u0129u r\u1ED3i
      \u0111\xE2y n\xE0y."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "C\xF3 g\xEC \u0111\xE2u em g\xE1i, ph\u1EA3i ai \u0111\u01B0\u1EE3c nh\u01B0
      em th\xEC anh \u0111\u1EE1 bi\u1EBFt m\u1EA5y."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "Em g\xE1i ph\xF2ng b\xEAn"
    text: "\xC0 anh n\xF3i ch\u1ECB k\u1EBF b\xEAn \xE0, ch\u1ECB \u1EA5y v\u1EADy
      th\xF4i ch\u1EE9 b\xECnh th\u01B0\u1EDDng t\u1ED1t l\u1EAFm. T\u1EA1i d\u1EA1o
      n\xE0y khu chung c\u01B0 n\xE0y c\xF3 v\xE0i chuy\u1EC7n h\u01A1i ph\u1EE9c
      t\u1EA1p n\xEAn ch\u1ECB \u1EA5y h\u01A1i kh\xF3 ch\u1ECBu th\xF4i anh \u1EA1."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Khu n\xE0y c\xF3 v\u1EE5 g\xEC h\u1EA3 em, anh v\u1EEBa \u0111\u1EBFn
      h\xF4m qua n\xEAn anh c\u0169ng kh\xF4ng r\xF5 n\u1EEFa."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "Em g\xE1i ph\xF2ng b\xEAn"
    text: "Ch\u1ECB \u1EA5y m\u1EA5y nay m\u1EA5t ng\u1EE7 v\xEC ph\xF2ng k\u1EBF
      b\xEAn c\xF3 ti\u1EBFng n\u01B0\u1EDBc ch\u1EA3y v\xE0 ti\u1EBFng l\u1EE5c
      \u0111\u1EE5c gi\u1EEFa \u0111\xEAm."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "Em g\xE1i ph\xF2ng b\xEAn"
    text: "M\u1EB7c d\xF9 \u0111\xE3 b\u1EA3o qu\u1EA3n l\xFD nh\u01B0ng h\u1ECD
      v\u1EABn ch\u01B0a x\u1EED l\xFD n\xEAn ch\u1ECB \u1EA5y h\u01A1i kh\xF3 ch\u1ECBu
      th\xF4i \u1EA1. C\xF3 g\xEC anh th\xF4ng c\u1EA3m cho ch\u1ECB \u1EA5y nh\xE9."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "\xC0 v\u1EADy \xE0, anh hi\u1EC3u r\u1ED3i , c\u1EA3m \u01A1n em nh\xE9."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0

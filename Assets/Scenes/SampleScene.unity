  m_Script: {fileID: 11500000, guid: 5775b86eb5e3ccb408e152ca2f82af6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryDoor
  day: {fileID: 923571958}
  orderIndex: 1
  hintText: "B\u1EA5m [E] \u0111\u1EC3 giao h\xE0ng"
  emptyHandText: "Ch\u01B0a c\xF3 h\xE0ng c\u1EE7a nh\xE0 n\xE0y \u2014 ra kho l\u1EA5y"
  wrongBoxText: "Kh\xF4ng ph\u1EA3i h\xE0ng c\u1EE7a nh\xE0 n\xE0y"
  npc: {fileID: 1518000785}
  deliverLines:
  - speakerName: "Ch\u1ECB g\xE1i xinh \u0111\u1EB9p"
    text: "Anh l\xE0m g\xEC m\xE0 l\xE2u th\u1EBF , t\xF4i \u0111\u1EE3i n\xE3y gi\u1EDD
      h\u01A1n 30 ph\xFAt r\u1ED3i v\u1EABn ch\u01B0a giao t\u1EDBi. Anh mu\u1ED1n
      \u0103n 1 sao thay v\xEC \u0103n c\u01A1m \xE0?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Ch\u1ECB th\xF4ng c\u1EA3m, thang m\xE1y h\xF4m nay \u0111\xF4ng qua n\xEAn
      em \u0111i l\u1EA5y h\xE0ng h\u01A1i l\xE2u."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Nhung m\xE0 em c\u0169ng tr\u1EC5 c\xF3 5 ph\xFAt m\xE0 ch\u1ECB n\xF3i
      30 ph\xFAt c\xF3 h\u01A1i qu\xE1 \u1EA1..."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "Ch\u1ECB g\xE1i xinh \u0111\u1EB9p"
    text: "Th\u1EBF \xE0, nh\u01B0ng 5 hay 30 ph\xFAt c\u0169ng l\xE0 tr\u1EC5. \u0110\u01B0a
      \u0111\u1ED3 cho t\xF4i r\u1ED3i chu\u1EA9n b\u1ECB nh\u1EADn \u0111\xE1nh
      gi\xE1 \"t\u1ED1t\" \u0111i nh\xE9."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "<i>(Th\xF4i giao l\u1EB9 r\u1ED3i \u0111i giao ch\u1ED7 kh\xE1c , con
      n\xE0y b\u1ECB \u0111i\xEAn r\u1ED3i).<i>"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0

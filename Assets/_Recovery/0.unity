--- !u!114 &302800242
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 302800240}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ed1edb9553328446be2c3a660451245, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Trigger
  questToGive:
    questId: 
    questName: 
    description: 
    isCompleted: 0
    isActive: 0
    isGoalReached: 0
  dialogueLines: []
  requiredQuestId: 
  dialogueBefore:
  - speakerName: "C\xF4 3"
    text: "Ch\xE1u m\u1EDBi chuy\u1EC3n t\u1EDBi \u0111\xE2y \xE0? Tr\xF4ng c\xF2n
      tr\u1EBB th\u1EBF, ch\u1EAFc l\xE0 sinh vi\xEAn nh\u1EC9?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "D\u1EA1 v\xE2ng, ch\xE1u v\u1EEBa ra tr\u01B0\u1EDDng, ti\u1EC7n xin \u0111\u01B0\u1EE3c
      vi\u1EC7c g\u1EA7n \u0111\xE2y n\xEAn thu\xEA \u1EDF lu\xF4n cho g\u1EA7n c\xF4
      \u1EA1."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "C\xF4 3"
    text: "Th\u1EBF \xE0, ch\xE1u \u1EDF ph\xF2ng n\xE0o, t\xF2a n\xE0o \u0111\u1EA5y?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Ch\xE1u \u1EDF ph\xF2ng 303, t\xF2a B c\xF4 \u1EA1."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "C\xF4 3"
    text: "Ph\xF2ng 302 ngay s\xE1t v\xE1ch v\u1EEBa tu\u1EA7n tr\u01B0\u1EDBc c\xF3
      ng\u01B0\u1EDDi t\u1EF1 t\u1EED \u0111\u1EA5y... Ch\xE1u \u1EDF c\u1EA1nh th\xEC
      ph\u1EA3i c\u1EA9n th\u1EADn. C\xE1i ph\xF2ng \u0111\xF3 tr\u01B0\u1EDBc gi\u1EDD
      ch\u1EB3ng l\xE0nh \u0111\xE2u, nhi\u1EC1u ng\u01B0\u1EDDi ch\u1EBFt trong
      \u0111\u1EA5y l\u1EAFm r\u1ED3i."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Gi\u1EDD ch\xE1u ch\u1EC9 s\u1EE3 kh\xF4ng c\xF3 ti\u1EC1n \u0111\xF3ng
      tr\u1ECD th\xF4i c\xF4 \u1EA1, ch\u1EE9 ma qu\u1EF7 ch\xE1u ch\u01B0a s\u1EE3
      l\u1EAFm \u0111\xE2u."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "C\xF4 3"
    text: "Ng\u01B0\u1EDDi tr\u1EBB c\xE1c ch\xE1u l\xFAc n\xE0o c\u0169ng ngh\u0129
      th\u1EBF. C\u1EEDa v\xE0o t\xF2a B \u1EDF \u0111\u1EB1ng kia, nh\u1EDB c\u1EA9n
      th\u1EADn \u0111\u1EA5y nh\xE9."
    questToGive:
      questId: ve_303
      questName: "V\u1EC1 nh\xE0 m\u1EDBi"
      description: "V\xE0o chung c\u01B0, l\xEAn ph\xF2ng 303"
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  dialogueDuring: []
  dialogueAfter: []
  playOnce: 1
  questToCompleteOnTalk: hoi_duong
  activateAfterTalk: []

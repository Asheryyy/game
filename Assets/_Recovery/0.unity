  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClueItem
  clueId: giay_note
  requiredClueId: 
  hintText: "B\u1EA5m [E] \u0111\u1EC3 \u0111\u1ECDc t\u1EDD gi\u1EA5y"
  autoTrigger: 0
  group: {fileID: 0}
  documentTitle: 
  documentText: "C\xF3 v\u1EBB nh\u01B0 c\xF3 v\u1EA5n \u0111\u1EC1 g\xEC \u0111\xF3
    l\u1EA1 l\u1EAFm m\xE0 t\xF4i kh\xF4ng bi\u1EBFt, t\xF4i c\xF3 linh c\u1EA3m
    kh\xF4ng t\u1ED1t.\nTi\u1EC1n n\u01B0\u1EDBc \u1EDF \u0111\xE2y cao b\u1EA5t
    th\u01B0\u1EDDng. T\xF4i \u0111\xE3 b\xE1o b\u1EA3o v\u1EC7\r\nnh\u01B0ng kh\xF4ng
    ai ch\u1ECBu l\xEAn ki\u1EC3m tra."

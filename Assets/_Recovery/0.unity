  m_Script: {fileID: 11500000, guid: 8d1315214c4b8694eb17003a561c952d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClueItem
  clueId: hoa_don_nuoc
  requiredClueId: 
  hintText: "B\u1EA5m [E] \u0111\u1EC3 nh\u1EB7t t\u1EDD gi\u1EA5y d\u01B0\u1EDBi
    c\u1EEDa"
  autoTrigger: 0
  group: {fileID: 0}
  documentTitle: "H\xD3A \u0110\u01A0N TI\u1EC0N N\u01AF\u1EDAC"
  documentText: "C\xF4ng ty C\u1EA5p n\u01B0\u1EDBc Sinh ho\u1EA1t\r\nK\u1EF3 thanh
    to\xE1n: Th\xE1ng 9/2025\r\n\r\nKh\xE1ch h\xE0ng: Ph\xF2ng 303 - T\xF2a B\r\nM\xE3
    kh\xE1ch h\xE0ng: CB-0303\r\n\r\nCh\u1EC9 s\u1ED1 c\u0169:         1.248 m\xB3\r\nCh\u1EC9
    s\u1ED1 m\u1EDBi:        1.302 m\xB3\r\nTi\xEAu th\u1EE5:          54 m\xB3\r\n\r\n\u0110\u01A1n
    gi\xE1:           14.800\u0111/m\xB3\r\n\r\nT\u1ED4NG TI\u1EC0N:         799.200\u0111\r\n\r\nH\u1EA1n
    thanh to\xE1n: 15/10/2025\r\nQu\xFD kh\xE1ch vui l\xF2ng thanh to\xE1n \u0111\xFAng
    h\u1EA1n."
  beforeReadLines:
  - speakerName: "T\xF4i"
    text: "Ai nh\xE9t gi\u1EA5y d\u01B0\u1EDBi c\u1EEDa th\u1EBF n\xE0y... H\xF3a
      \u0111\u01A1n ti\u1EC1n n\u01B0\u1EDBc?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  documentFont: {fileID: 0}
  documentColor: {r: 0, g: 0, b: 0, a: 0}
  thoughts:
  - speakerName: "T\xF4i"
    text: "800 ngh\xECn?! M\xECnh nh\u1EDB ch\u0169 thu\xEA c\u0169 \u1EDF m\u1ED9t
      m\xECnh m\xE0, sao l\u1EA1i nhi\u1EC1u nh\u01B0 th\u1EBF \u0111\u01B0\u1EE3c."
    questToGive:
      questId: tien_nuoc
      questName: "Ti\u1EC1n n\u01B0\u1EDBc b\u1EA5t th\u01B0\u1EDDng"
      description: "Ki\u1EC3m tra \u0111\u1ED3ng h\u1ED3 n\u01B0\u1EDBc ngo\xE0i
        h\xE0nh lang"
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "Ph\u1EA3i xem \u0111\u1ED3ng h\u1ED3 n\u01B0\u1EDBc m\u1EDBi \u0111\u01B0\u1EE3c."
    questToGive:
      questId: 
      questName: 

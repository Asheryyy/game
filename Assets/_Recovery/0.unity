--- !u!114 &1154931765
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1154931763}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ed1edb9553328446be2c3a660451245, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Trigger
  questToGive:
    questId: 
    questName: 
    description: 
    isCompleted: 0
    isActive: 0
    isGoalReached: 0
  dialogueLines: []
  requiredQuestId: kiem_tra_302
  dialogueBefore:
  - speakerName: "H\xE0ng x\xF3m"
    text: "Ch\xE1u l\xE0 ng\u01B0\u1EDDi m\u1EDBi d\u1ECDn v\xE0o 303 h\u1EA3?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "D\u1EA1. C\xF4 cho ch\xE1u h\u1ECFi, ph\xF2ng 302 c\xF3 ai \u1EDF kh\xF4ng
      \u1EA1?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "H\xE0ng x\xF3m"
    text: "B\u1ECF tr\u1ED1ng l\xE2u r\u1ED3i. M\xE0... ch\xE1u bi\u1EBFt con b\xE9
      \u1EDF 303 tr\u01B0\u1EDBc ch\xE1u kh\xF4ng?"
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "H\xE0ng x\xF3m"
    text: "Con b\xE9 sinh vi\xEAn, hi\u1EC1n l\u1EAFm. \u0110\xEAm m\u01B0a h\xF4m
      14 th\xE1ng tr\u01B0\u1EDBc t\u1EF1 nhi\xEAn bi\u1EBFn m\u1EA5t, \u0111\u1ED3
      \u0111\u1EA1c v\u1EABn \u0111\u1EC3 nguy\xEAn."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "H\xE0ng x\xF3m"
    text: "Ch\u1EE7 nh\xE0 b\u1EA3o n\xF3 tr\u1ED1n ti\u1EC1n nh\xE0. Nh\u01B0ng
      c\xF4 th\u1EA5y l\u1EA1 l\u1EAFm..."
    questToGive:
      questId: 
      questName: 
      description: 
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  - speakerName: "T\xF4i"
    text: "...C\u1EA3m \u01A1n c\xF4. Ch\xE1u v\u1EC1 ph\xF2ng \u0111\xE2y."
    questToGive:
      questId: ve_phong
      questName: "V\u1EC1 ph\xF2ng"
      description: "Quay v\u1EC1 ph\xF2ng 303"
      isCompleted: 0
      isActive: 0
      isGoalReached: 0
  dialogueDuring: []
  dialogueAfter: []
  playOnce: 1
  questToCompleteOnTalk: hoi_hang_xom
  activateAfterTalk:
  - {fileID: 1585086095}
